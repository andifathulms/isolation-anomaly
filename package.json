{
  "name": "isolation-anomaly",
  "version": "0.1.0",
  "private": true,
  "description": "Isolation Anomaly — hand-built transaction schedules executed against modelled database engines, with anomalies named and cited.",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm packs:validate && next build",
    "preview": "node scripts/preview.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:oracle": "vitest run tests/oracle",
    "test:anomalies": "vitest run tests/anomalies",
    "test:serial": "vitest run tests/serial",
    "packs:validate": "tsx scripts/validate-packs.ts",
    "oracle:record": "tsx scripts/oracle/record.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "mysql2": "3.11.3",
    "pg": "8.13.0",
    "@types/pg": "8.11.10",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  },
  "packageManager": "pnpm@9.15.9"
}
